msgstr "僅限車輛"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_policy.py
# 說明: 策略選項 - 僅限圖資
msgid "Map Only"
msgstr "僅限圖資"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_policy.py
# 說明: 策略選項 - 車輛優先
msgid "Car First"
msgstr "車輛優先"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_policy.py
# 說明: 策略選項 - 圖資優先
msgid "Map First"
msgstr "圖資優先"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_policy.py
# 說明: 策略選項 - 綜合
msgid "Combined"
msgstr "綜合"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_policy.py
# 說明: 策略選項說明 - 僅限車輛
msgid "Car Only: Use Speed Limit data only from Car"
msgstr "僅限車輛：僅使用來自車輛的速限資料"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_policy.py
# 說明: 策略選項說明 - 僅限圖資
msgid "Map Only: Use Speed Limit data only from OpenStreetMaps"
msgstr "僅限圖資：僅使用來自 OpenStreetMaps 的速限資料"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_policy.py
# 說明: 策略選項說明 - 車輛優先
msgid "Car First: Use Speed Limit data from Car if available, else use from OpenStreetMaps"
msgstr "車輛優先：若可用則優先使用車輛的速限資料，否則使用 OpenStreetMaps"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_policy.py
# 說明: 策略選項說明 - 圖資優先
msgid "Map First: Use Speed Limit data from OpenStreetMaps if available, else use from Car"
msgstr "圖資優先：若可用則優先使用 OpenStreetMaps 的速限資料，否則使用車輛資料"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_policy.py
# 說明: 策略選項說明 - 綜合
msgid "Combined: Use combined Speed Limit data from Car & OpenStreetMaps"
msgstr "綜合：使用結合車輛與 OpenStreetMaps 的速限資料"


