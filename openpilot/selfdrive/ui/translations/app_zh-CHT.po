# 說明: 轉向模式選項 - 暫停
msgid "Pause"
msgstr "暫停"

#: openpilot/system/ui/sunnypilot/mads_settings.py
# 說明: 轉向模式選項詳細說明 - 暫停
msgid "Pause: ALC will pause when the brake pedal is pressed."
msgstr "暫停：踩下煞車踏板時，自動車道置中 (ALC) 將暫停。"

#: openpilot/system/ui/sunnypilot/mads_settings.py
# 說明: 轉向模式選項 - 解除
msgid "Disengage"
msgstr "解除"

#: openpilot/system/ui/sunnypilot/mads_settings.py
# 說明: 轉向模式選項詳細說明 - 解除
msgid "Disengage: ALC will disengage when the brake pedal is pressed."
msgstr "解除：踩下煞車踏板時，自動車道置中 (ALC) 將解除。"

