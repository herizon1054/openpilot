#: openpilot/system/ui/sunnypilot/torque_settings.py
# 說明: 自動調校功能詳細描述
msgid "Enables self-tune for Torque lateral control for platforms that do not use Torque lateral control by default."
msgstr "為預設不使用扭矩橫向控制的平台，啟用扭矩橫向控制自動調校。"

#: openpilot/system/ui/sunnypilot/torque_settings.py
# 說明: 寬鬆自動調校設定標題
msgid "Less Restrict Settings for Self-Tune (Beta)"
msgstr "較寬鬆的自動調校設定 (Beta)"

#: openpilot/system/ui/sunnypilot/torque_settings.py
# 說明: 寬鬆自動調校設定描述
msgid "Less strict settings when using Self-Tune. This allows torqued to be more forgiving when learning values."
msgstr "使用自動調校時放寬限制。這能讓扭矩控制在學習數值時有更大的容錯空間。"

#: openpilot/system/ui/sunnypilot/torque_settings.py
# 說明: 自訂調校功能標題
msgid "Enable Custom Tuning"
msgstr "啟用自訂調校"

#: openpilot/system/ui/sunnypilot/torque_settings.py
# 說明: 自訂調校功能詳細描述
msgid "Enables custom tuning for Torque lateral control. Modifying Lateral Acceleration Factor and Friction below will override the offline values indicated in the YAML files within \"opendbc/car/torque_data\". The values will also be used live when \"Manual Real-Time Tuning\" toggle is enabled."
msgstr "啟用扭矩橫向控制的自訂調校。修改下方的「橫向加速度係數」與「摩擦力」將會覆蓋 \"opendbc/car/torque_data\" 中 YAML 檔案的離線數值。當啟用「手動即時調校」時，這些數值也會即時生效。"

#: openpilot/system/ui/sunnypilot/torque_settings.py
# 說明: 手動即時調校標題
msgid "Manual Real-Time Tuning"
msgstr "手動即時調校"

#: openpilot/system/ui/sunnypilot/torque_settings.py
# 說明: 手動即時調校詳細描述
msgid "Enforces the torque lateral controller to use the fixed values instead of the learned values from Self-Tune. Enabling this toggle overrides Self-Tune values."
msgstr "強制扭矩橫向控制器使用固定數值，而非自動調校的學習數值。啟用此功能將覆蓋自動調校的結果。"

#: openpilot/system/ui/sunnypilot/torque_settings.py
# 說明: 橫向加速度係數標題
msgid "Lateral Acceleration Factor"
msgstr "橫向加速度係數"

#: openpilot/system/ui/sunnypilot/torque_settings.py
# 說明: 摩擦力設定標題
msgid "Friction"
msgstr "摩擦力設定"

# ==============================================================================
# 巡航控制設定 (Cruise Settings)
# 來源檔案: cruise.py
# ==============================================================================

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 智慧巡航按鈕管理功能標題
msgid "Intelligent Cruise Button Management (ICBM) (Alpha)"
msgstr "智慧巡航按鈕管理 (ICBM) (Alpha)"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: ICBM 功能詳細描述
msgid "When enabled, sunnypilot will attempt to manage the built-in cruise control buttons by emulating button presses for limited longitudinal control."
msgstr "啟用後，sunnypilot 將嘗試透過模擬按鈕按下來管理內建的巡航控制按鈕，以實現有限的縱向控制。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: ICBM 平台不支援提示
msgid "Intelligent Cruise Button Management is currently unavailable on this platform."
msgstr "智慧巡航按鈕管理目前在此平台上無法使用。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 需停用縱向控制以啟用 ICBM 提示
msgid "Disable the sunnypilot Longitudinal Control (alpha) toggle to allow Intelligent Cruise Button Management."
msgstr "停用 sunnypilot 縱向控制 (alpha) 切換，以允許使用智慧巡航按鈕管理。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 縱向控制為預設設定之提示
msgid "sunnypilot Longitudinal Control is the default longitudinal control for this platform."
msgstr "sunnypilot 縱向控制是此平台的預設縱向控制。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 自訂 ACC 短按/長按增量功能描述
msgid "Enable custom Short & Long press increments for cruise speed increase/decrease."
msgstr "啟用自訂短按與長按增量，用於巡航速度的增減。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 功能限制提示 - 需啟用縱向控制
msgid "This feature can only be used with sunnypilot longitudinal control enabled."
msgstr "此功能僅能在啟用 sunnypilot 縱向控制時使用。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 功能限制提示 - 車輛不支援
msgid "This feature is not supported on this platform due to vehicle limitations."
msgstr "由於車輛限制，此平台不支援此功能。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 智慧巡航控制 - 視覺功能標題
msgid "Smart Cruise Control - Vision"
msgstr "智慧巡航控制 - 視覺"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 智慧巡航控制 - 視覺功能描述
msgid "Use vision path predictions to estimate the appropriate speed to drive through turns ahead."
msgstr "使用視覺路徑預測來估計通過前方彎道的適當速度。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 智慧巡航控制 - 圖資功能標題
msgid "Smart Cruise Control - Map"
msgstr "智慧巡航控制 - 圖資"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 智慧巡航控制 - 圖資功能描述
msgid "Use map data to estimate the appropriate speed to drive through turns ahead."
msgstr "使用圖資資料來估計通過前方彎道的適當速度。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 自訂 ACC 速度增量功能標題
msgid "Custom ACC Speed Increments"
msgstr "自訂 ACC 速度增量"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 短按增量設定標題
msgid "Short Press Increment"
msgstr "短按增量"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 長按增量設定標題
msgid "Long Press Increment"
msgstr "長按增量"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 速限設定按鈕標題
msgid "Speed Limit"
msgstr "速限"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 動態實驗控制功能標題
msgid "Enable Dynamic Experimental Control"
msgstr "啟用動態實驗控制"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 動態實驗控制功能描述
msgid "Enable toggle to allow the model to determine when to use sunnypilot ACC or sunnypilot End to End Longitudinal."
msgstr "啟用此切換，允許模型決定何時自動使用 sunnypilot ACC 或 sunnypilot 端到端縱向控制。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 加速風格控制功能標題
msgid "Enable AccelPersonality Control"
msgstr "啟用加速風格控制 (AccelPersonality) "

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 加速風格選擇清單標題
msgid "Accel Personality"
msgstr "加速風格"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 加速風格選項 - 運動
msgid "Sport"
msgstr "運動"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 加速風格選項 - 一般
msgid "Normal"
msgstr "一般"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 加速風格選項 - 節能
msgid "ECO"
msgstr "節能"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 動態彎道速度控制器標題
msgid "Enable Dynamic Turn Speed Controller"
msgstr "啟用動態彎道速度(DTSC)"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
# 說明: 路徑偏移監控標題
msgid "Enable Path Deviation Monitor"
msgstr "啟用路徑偏移監控(PDM)"


