#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_settings.py
# 說明: 速限模式選項 - 警告
msgid "Warning"
msgstr "警告"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_settings.py
# 說明: 速限模式選項 - 輔助
msgid "Assist"
msgstr "輔助"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_settings.py
# 說明: 偏移類型選項 - 無
msgid "None"
msgstr "無"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_settings.py
# 說明: 偏移類型選項 - 固定值
msgid "Fixed"
msgstr "固定值"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_settings.py
# 說明: 偏移類型選項 - 百分比符號
msgid "%"
msgstr "%"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_settings.py
# 說明: 模式選項說明 - 關閉
msgid "Off: Disables the Speed Limit functions."
msgstr "關閉：停用速限相關功能。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_settings.py
# 說明: 模式選項說明 - 資訊
msgid "Information: Displays the current road's speed limit."
msgstr "資訊：顯示當前道路的速限。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_settings.py
# 說明: 模式選項說明 - 警告
msgid "Warning: Provides a warning when exceeding the current road's speed limit."
msgstr "警告：當超過當前道路的速限時提供警告。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_settings.py
# 說明: 模式選項說明 - 輔助
msgid "Assist: Adjusts the vehicle's cruise speed based on the current road's speed limit when operating the +/- buttons."
msgstr "輔助：操作 +/- 按鈕時，根據當前道路的速限調整車輛的巡航速度。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_settings.py
# 說明: 自訂速限來源按鈕標題
msgid "Customize Source"
msgstr "自訂來源"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_settings.py
# 說明: 速限偏移值標題
msgid "Speed Limit Offset"
msgstr "速限偏移值"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_settings.py
# 說明: 偏移類型說明 - 無
msgid "None: No Offset"
msgstr "無：無偏移值"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_settings.py
# 說明: 偏移類型說明 - 固定值
msgid "Fixed: Adds a fixed offset [Speed Limit + Offset]"
msgstr "固定值：增加固定的偏移值 [速限 + 偏移值]"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/speed_limit_settings.py
# 說明: 偏移類型說明 - 百分比
msgid "Percent: Adds a percent offset [Speed Limit + (Offset % Speed Limit)]"
msgstr "百分比：增加百分比偏移值 [速限 + (偏移值 % 速限)]"

# ==============================================================================
# 視覺設定 (Visuals Settings)
# 來源檔案: visuals.py
# ==============================================================================

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 追蹤前車箭頭下方的指標功能啟用時的描述
msgid "Display useful metrics below the chevron that tracks the lead car only applicable to cars with sunnypilot longitudinal control."
msgstr "在追蹤前車的箭頭下方顯示有用的指標，僅適用於具備 sunnypilot 縱向控制的車款。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 追蹤前車箭頭下方的指標功能停用時的描述（不支援縱向控制）
msgid "This feature requires sunnypilot longitudinal control to be available."
msgstr "此功能需要 sunnypilot 縱向控制可用。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 盲點警示功能標題
msgid "Show Blind Spot Warnings"
msgstr "顯示盲點警示"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 盲點警示功能詳細描述
msgid "Enabling this will display warnings when a vehicle is detected in your blind spot as long as your car has BSM supported."
msgstr "只要您的車輛支援 BSM，啟用此功能將在您的盲點偵測到車輛時顯示警示。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 轉向弧線功能標題
msgid "Steering Arc"
msgstr "啟用 轉向扭矩 動態顯示"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 轉向弧線功能詳細描述
msgid "Display steering arc on the driving screen when lateral control is enabled."
msgstr "啟用橫向控制時，在駕駛畫面上顯示轉向扭矩。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: Tesla 彩虹模式功能標題
msgid "Enable Tesla Rainbow Mode"
msgstr "啟用 Tesla 彩虹模式"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: Tesla 彩虹模式功能詳細描述
msgid "A beautiful rainbow effect on the path the model wants to take. It does not affect driving in any way."
msgstr "在模型預測的路徑上顯示美麗的彩虹效果。這完全不會影響駕駛。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 靜止計時器功能標題
msgid "Enable Standstill Timer"
msgstr "啟用靜止計時器"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 靜止計時器功能詳細描述
msgid "Show a timer on the HUD when the car is at a standstill."
msgstr "當車輛靜止時，在 HUD 上顯示計時器。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 顯示道路名稱功能標題
msgid "Display Road Name"
msgstr "顯示道路名稱"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 顯示道路名稱功能詳細描述
msgid "Displays the name of the road the car is traveling on.<br>The OpenStreetMap database of the location must be downloaded from the OSM panel to fetch the road name."
msgstr "顯示車輛正在行駛的道路名稱。<br>必須從 OSM 面板下載該位置的 OpenStreetMap 資料庫才能獲取道路名稱。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 綠燈提示功能標題
msgid "Green Traffic Light Alert (Beta)"
msgstr "綠燈提示 (Beta)"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 綠燈提示功能詳細描述
msgid "A chime and on-screen alert will play when the traffic light you are waiting for turns green and you have no vehicle in front of you.<br>Note: This chime is only designed as a notification. It is the driver's responsibility to observe their environment and make decisions accordingly."
msgstr "當您等待的交通號誌變綠且前方無車輛時，將播放提示音並在螢幕上顯示警示。<br>Note: 此提示音僅設計為通知。駕駛人有責任觀察周遭環境並做出相應決定。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 前車起步提示功能標題
msgid "Lead Departure Alert (Beta)"
msgstr "前車起步警示 (Beta)"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 前車起步提示功能詳細描述
msgid "A chime and on-screen alert will play when you are stopped, and the vehicle in front of you start moving.<br>Note: This chime is only designed as a notification. It is the driver's responsibility to observe their environment and make decisions accordingly."
msgstr "當您處於停止狀態且前車開始移動時，將播放提示音並在螢幕上顯示警示。<br>Note: 此提示音僅設計為通知。駕駛人有責任觀察周遭環境並做出相應決定。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 永遠顯示真實車速功能標題
msgid "Speedometer: Always Display True Speed"
msgstr "時速表：永遠顯示真實車速"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 永遠顯示真實車速功能詳細描述
msgid "For applicable vehicles, always display the true vehicle current speed from wheel speed sensors."
msgstr "對於適用的車款，永遠顯示來自輪速感測器的真實車輛當前速度。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 在駕駛畫面隱藏時速表功能標題
msgid "Speedometer: Hide from Onroad Screen"
msgstr "時速表：在駕駛畫面上隱藏"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/visuals.py
# 說明: 在駕駛畫面隱藏時速表功能詳細描述
